# Optional public Formspree / Apps Script / webhook URL inlined at build time.
# Example: https://formspree.io/f/xxxxxxxx
NEXT_PUBLIC_UNSUBSCRIBE_ENDPOINT=

# Optional public approval webhook. Per-batch webhook_url in public/approve/batch.json wins.
# See APPROVE.md. This value is inlined into the static bundle (it is not a secret).
NEXT_PUBLIC_APPROVAL_WEBHOOK_URL=
