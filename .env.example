# Optional public Formspree / Apps Script / webhook URL inlined at build time.
# Example: https://formspree.io/f/xxxxxxxx
NEXT_PUBLIC_UNSUBSCRIBE_ENDPOINT=

# Public approval PROXY base URL (no trailing slash). Browser uses WebAuthn
# against this host, then GET /batch and POST /decision with a session token.
# Never a Cursor sender key. See APPROVE.md.
NEXT_PUBLIC_APPROVAL_PROXY_URL=https://authorized-philip-mechanics-rick.trycloudflare.com
